---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/listing.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Preloader from '../components/Preloader.astro';
import { firm } from '../data/firm';

interface Props {
  title?: string;
  description?: string;
  preloader?: boolean;
}

const {
  title,
  description = `${firm.name} — firma hukum korporasi, litigasi, dan regulasi di Jakarta, Surabaya, dan Denpasar.`,
  preloader = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${firm.name}` : `${firm.name} — ${firm.tagline}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0c0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Tandai kemampuan animasi sebelum render agar tidak ada kedipan konten -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
          if (sessionStorage.getItem('wp-loaded')) d.classList.add('loaded-once');
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    {preloader && <Preloader />}
    <Cursor />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
